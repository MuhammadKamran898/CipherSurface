<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.*" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- What Microsoft.NET.Sdk.Web would add; this project hosts the API but is a plain test project. -->
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/CipherSurface.Api/CipherSurface.Api.csproj" />
    <ProjectReference Include="../../src/CipherSurface.Auth/CipherSurface.Auth.csproj" />
    <ProjectReference Include="../../src/CipherSurface.Services/CipherSurface.Services.csproj" />
    <ProjectReference Include="../../src/CipherSurface.Data/CipherSurface.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The same throwaway PostgreSQL container fixture the Services tests use. -->
    <Compile Include="../CipherSurface.Services.Tests/PostgresFixture.cs" Link="PostgresFixture.cs" />
  </ItemGroup>
</Project>
